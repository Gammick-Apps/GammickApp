{
  "name": "gammick",
  "productName": "GammickApp",
  "description": "Point accumulation system",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "watch": "nodemon --exec electron .",
    "reset": "git reset --hard",
    "build": "electron-builder --win portable"
  },
  "keywords": [
    "Electron",
    "barcode"
  ],
  "author": "Efrat Malka",
  "license": "CC0-1.0",
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^2.0.0"
  },
  "dependencies": {
    "ag-grid-community": "^30.2.1",
    "bootstrap": "^5.3.0-alpha1",
    "jquery": "^3.6.3"
  },
  "build": {
    "appId": "com.gammick.app",
    "productName": "Gammick",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
